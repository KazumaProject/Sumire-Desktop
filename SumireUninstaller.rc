#include "SumireVersion.h"
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SUMIRE_VERSION_MAJOR,SUMIRE_VERSION_MINOR,SUMIRE_VERSION_PATCH,SUMIRE_VERSION_BUILD
 PRODUCTVERSION SUMIRE_VERSION_MAJOR,SUMIRE_VERSION_MINOR,SUMIRE_VERSION_PATCH,SUMIRE_VERSION_BUILD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", SUMIRE_COMPANY_NAME "\0"
            VALUE "FileDescription", "Sumire IME Uninstaller\0"
            VALUE "FileVersion", SUMIRE_VERSION_STRING "\0"
            VALUE "InternalName", "SumireUninstaller.exe\0"
            VALUE "LegalCopyright", SUMIRE_LEGAL_COPYRIGHT "\0"
            VALUE "OriginalFilename", "SumireUninstaller.exe\0"
            VALUE "ProductName", SUMIRE_PRODUCT_NAME "\0"
            VALUE "ProductVersion", SUMIRE_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
